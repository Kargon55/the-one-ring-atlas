  "nodes": [
    {
      "id": "FGjP9n1h",
      "section": "hero",
      "parts": [
        {
          "id": "ggZTaQL4",
          "text": "Три основные характеристики героя — Сила, Сердце и Разум. Они отражают его физические, духовные и умственные способности."
        }
      ],
      "title": "Характеристики",
      "image": null,
      "pages": "29"
    },
    {
      "id": "z7mA2lwC",
      "section": "hero",
      "parts": [
        {
          "id": "60UdT3uc",
          "text": "Основные характеристики определяют максимум Выносливости, максимум Надежды и рейтинг Парирования.\n\nВыносливость связана с Силой, Надежда — с Сердцем, Парирование — с Разумом."
        }
      ],
      "title": "Производные характеристики",
      "image": null,
      "pages": "29, 32–43"
    },
    {
      "id": "UXrTt2lW",
      "section": "hero",
      "parts": [
        {
          "id": "KyhsKinq",
          "text": "Навыки отражают, что герой умеет делать и насколько хорошо. При проверке бросьте Кость испытания и число Костей успеха, равное рейтингу навыка."
        }
      ],
      "title": "Навыки",
      "image": null,
      "pages": "30, 60–64"
    },
    {
      "id": "new_combat_skills",
      "section": "hero",
      "parts": [
        {
          "id": "Ppu339Qg",
          "text": "Боевые умения отражают мастерство героя в бою. При проверке бросьте Кость испытания и число Костей успеха, равное рейтингу Боевого умения. Все проверки атаки совершаются против ЦЧ Силы."
        }
      ],
      "title": "Боевые умения",
      "image": null,
      "pages": "30, 65–66"
    },
    {
      "id": "yTeGQ2Ru",
      "section": "hero",
      "parts": [
        {
          "id": "VltpUv7T",
          "text": "Отражает храбрость героя и славу, заслуженную великими деяниями. Проверка Доблести совершается против ЦЧ Сердца."
        }
      ],
      "title": "Доблесть",
      "image": null,
      "pages": "51, 78–79"
    },
    {
      "id": "4iaoPg7jyedAgq6Bg9Ucq",
      "section": "hero",
      "parts": [
        {
          "id": "iYGWUXk1",
          "text": "Отражает уверенность героя в себе, зрелость и здравомыслие. Проверка Мудрости совершается против ЦЧ Разума."
        }
      ],
      "title": "Мудрость",
      "image": null,
      "pages": "78, 80–81, 136"
    },
